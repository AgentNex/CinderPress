# 27. DATABASE DIAGRAM

Use this conceptual ER model.

```mermaid
erDiagram
    PUBLICATION ||--o{ AUTHOR : has
    PUBLICATION ||--o{ POST : contains
    AUTHOR ||--o{ POST : writes
    POST ||--o{ POST_REVISION : has
    POST ||--o{ COMMENT : receives
    POST }o--o{ CATEGORY : classified_by
    POST }o--o{ TAG : tagged_with
    PUBLICATION ||--o{ MEDIA : owns
    POST ||--o| MEDIA : cover
    POST }o--o{ MEDIA : references

    PUBLICATION {
        string id
        string name
        string slug
        string description
        string theme_config
        string seo_defaults
        datetime created_at
        datetime updated_at
    }

    AUTHOR {
        string id
        string publication_id
        string auth_user_id
        string display_name
        string slug
        string bio
        string avatar_media_id
        datetime created_at
        datetime updated_at
    }

    POST {
        string id
        string publication_id
        string author_id
        string title
        string slug
        string dek
        string excerpt
        string content_json
        string content_html
        string cover_media_id
        string status
        string visibility
        datetime published_at
        datetime scheduled_at
        integer reading_time_minutes
        string canonical_url
        string seo_title
        string seo_description
        datetime created_at
        datetime updated_at
    }

    POST_REVISION {
        string id
        string post_id
        string author_id
        string snapshot_json
        datetime created_at
    }

    CATEGORY {
        string id
        string publication_id
        string name
        string slug
        string description
    }

    TAG {
        string id
        string publication_id
        string name
        string slug
    }

    MEDIA {
        string id
        string publication_id
        string owner_auth_user_id
        string cloudinary_public_id
        string cloudinary_asset_id
        string resource_type
        string secure_url
        string format
        integer width
        integer height
        integer duration
        integer bytes
        string alt_text
        string caption
        string credit
        datetime created_at
        datetime updated_at
    }

    COMMENT {
        string id
        string post_id
        string author_name
        string author_email
        string body
        string status
        datetime created_at
        datetime updated_at
    }
```

